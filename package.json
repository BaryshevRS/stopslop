{
  "name": "stopslop",
  "version": "1.1.0",
  "description": "Static analysis for AI-generated JavaScript and TypeScript: find cognitive complexity, god classes/modules, duplicate code, dead code and orphan features.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaryshevRS/stopslop.git"
  },
  "homepage": "https://github.com/BaryshevRS/stopslop#readme",
  "bugs": {
    "url": "https://github.com/BaryshevRS/stopslop/issues"
  },
  "bin": {
    "stopslop": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "docs/**/*.md",
    "README.md",
    "COMPATIBILITY.md",
    "LICENSE",
    "llms.txt",
    "context7.json",
    "schema.json"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@10.1.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm schema:check && pnpm rules:check",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node scripts/package-smoke.mjs",
    "check:clones": "clone-alert --minimum-tokens 100 --files src --format text --fail-on-violation",
    "audit:prod": "pnpm audit --prod",
    "ci:check": "pnpm test && pnpm typecheck && pnpm check:clones && pnpm build",
    "release:check": "pnpm ci:check && pnpm audit:prod && pnpm test:package",
    "prepublishOnly": "pnpm release:check",
    "calibrate": "tsx scripts/calibrate.ts",
    "typecheck": "tsc --noEmit",
    "schema:generate": "tsx scripts/generate-config-schema.ts",
    "schema:check": "tsx scripts/generate-config-schema.ts --check",
    "rules:generate": "tsx scripts/generate-rules-doc.ts",
    "rules:check": "tsx scripts/generate-rules-doc.ts --check",
    "commitlint": "commitlint",
    "prepare": "simple-git-hooks 1>&2"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit \"$1\""
  },
  "dependencies": {
    "clone-alert": "^1.1.3",
    "knip": "6.39.0",
    "oxc-parser": "^0.139.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.1",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@types/node": "^22.10.0",
    "publint": "^0.3.8",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.21.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "ai",
    "ai-code",
    "ai-generated-code",
    "ai-code-quality",
    "ai-slop",
    "slop",
    "slop-detector",
    "vibe-coding",
    "static-analysis",
    "code-analysis",
    "code-quality",
    "code-smell",
    "technical-debt",
    "javascript",
    "typescript",
    "jsx",
    "tsx",
    "cli",
    "lint",
    "ci",
    "quality-gate",
    "code-scanning",
    "github-actions",
    "sarif",
    "baseline",
    "god-class",
    "god-module",
    "cognitive-complexity",
    "lcom",
    "cohesion",
    "duplicate-code",
    "copy-paste-detector",
    "dead-code",
    "unused-code",
    "orphan-code",
    "monorepo",
    "code-review"
  ]
}
