{
  "name": "stopslop",
  "version": "0.1.2",
  "description": "Detects AI-agent slop that linters miss: over-complex functions, god modules/classes, dumped responsibilities.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaryshevRS/stopslop.git"
  },
  "homepage": "https://github.com/BaryshevRS/stopslop#readme",
  "bugs": {
    "url": "https://github.com/BaryshevRS/stopslop/issues"
  },
  "bin": {
    "stopslop": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.json": "./schema.json"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@10.1.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm schema:check",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node scripts/package-smoke.mjs",
    "audit:prod": "pnpm audit --prod",
    "ci:check": "pnpm test && pnpm typecheck && pnpm build",
    "release:check": "pnpm ci:check && pnpm audit:prod && pnpm test:package",
    "prepublishOnly": "pnpm release:check",
    "calibrate": "tsx scripts/calibrate.ts",
    "typecheck": "tsc --noEmit",
    "schema:generate": "tsx scripts/generate-config-schema.ts",
    "schema:check": "tsx scripts/generate-config-schema.ts --check",
    "commitlint": "commitlint",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit \"$1\""
  },
  "dependencies": {
    "clone-alert": "^1.1.3",
    "knip": "6.31.0",
    "oxc-parser": "^0.139.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.1",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@types/node": "^22.10.0",
    "publint": "^0.3.8",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.21.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "ai",
    "slop",
    "code-smell",
    "god-class",
    "god-module",
    "cognitive-complexity",
    "lcom",
    "static-analysis"
  ]
}
